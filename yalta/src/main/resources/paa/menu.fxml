<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox" alignment="CENTER" spacing="28" style="-fx-background-color: linear-gradient(to bottom, #f3f3ec, #d9dfc8);" xmlns:fx="http://javafx.com/fxml">
    <children>
        <Label text="Plateau Yalta" style="-fx-font-family: 'Consolas'; -fx-font-size: 42; -fx-font-weight: bold;" />
        <Button fx:id="playButton" prefHeight="48" prefWidth="260" text="Lancer le plateau" style="-fx-font-family: 'Consolas'; -fx-font-size: 18; -fx-font-weight: bold;" onMouseClicked="#handleCellClick" />
    </children>
</fx:root>
