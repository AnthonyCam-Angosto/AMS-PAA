<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox" alignment="CENTER" spacing="14" style="-fx-background-color: linear-gradient(to bottom, #192340, #0f1829); -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #4da6ff; -fx-border-width: 2; -fx-border-radius: 12;" xmlns:fx="http://javafx.com/fxml">
    <children>
        <Label fx:id="titleLabel" text="Fin de partie" style="-fx-font-family: 'Consolas'; -fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #4da6ff;" />
        <Label fx:id="resultLabel" text="Victoire" style="-fx-font-family: 'Consolas'; -fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #4ade80;" />
        <Label fx:id="winnerLabel" text="Joueur BLANC gagne" style="-fx-font-family: 'Consolas'; -fx-font-size: 14; -fx-text-fill: #b8c5d6;" />
        <Label fx:id="detailLabel" text="Echec et mat" style="-fx-font-family: 'Consolas'; -fx-font-size: 13; -fx-text-fill: #7a8ba8; -fx-opacity: 0.85;" />

        <Region prefHeight="4" />

        <HBox alignment="CENTER" spacing="10">
            <children>
                <Button fx:id="restartButton" prefWidth="120" prefHeight="38" text="Rejouer" style="-fx-font-family: 'Consolas'; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-color: linear-gradient(to bottom, #4da6ff, #2d7fd1); -fx-text-fill: #ffffff; -fx-border-radius: 6; -fx-background-radius: 6;" />
                <Button fx:id="menuButton" prefWidth="120" prefHeight="38" text="Menu" style="-fx-font-family: 'Consolas'; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-color: linear-gradient(to bottom, #4da6ff, #2d7fd1); -fx-text-fill: #ffffff; -fx-border-radius: 6; -fx-background-radius: 6;" />
                <Button fx:id="closeButton" prefWidth="120" prefHeight="38" text="Fermer" style="-fx-font-family: 'Consolas'; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-color: linear-gradient(to bottom, #4da6ff, #2d7fd1); -fx-text-fill: #ffffff; -fx-border-radius: 6; -fx-background-radius: 6;" />
            </children>
        </HBox>
    </children>
</fx:root>
