<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox" alignment="CENTER" spacing="28" style="-fx-background-color: linear-gradient(to bottom, #f3f3ec, #d9dfc8);" xmlns:fx="http://javafx.com/fxml">
    <children>
        <Label text="Echecs Yalta" style="-fx-font-family: 'Consolas'; -fx-font-size: 42; -fx-font-weight: bold;" />

        <VBox alignment="CENTER" spacing="12">
            <Label text="Nombre de joueurs :" style="-fx-font-family: 'Consolas'; -fx-font-size: 18;" />
            <Spinner fx:id="playerCountSpinner" editable="false" prefWidth="120" />
        </VBox>
        <Button fx:id="playButton" prefHeight="48" prefWidth="260" text="Lancer le jeu" style="-fx-font-family: 'Consolas'; -fx-font-size: 18; -fx-font-weight: bold;" onAction="#handleCellClick" />
    </children>
</fx:root>
